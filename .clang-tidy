# AGS Draconian static analysis and naming rules. See docs/refactor/STYLE.md.
# Pinned tool: clang-tidy 19.1.x. Needs compile_commands.json (cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON).
#
# The legacy code violates most of these, so CI runs clang-tidy on *changed lines only*
# (Script/tidy_diff.py) until a module is cleaned up; see docs/refactor/PLAN.md, task 2.4.
# Third-party code is excluded by HeaderFilterRegex and by only passing first-party sources.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-switch-missing-default-case,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-use-bool-literals,
  modernize-use-emplace,
  modernize-make-unique,
  modernize-redundant-void-arg,
  modernize-deprecated-headers,
  readability-identifier-naming,
  readability-function-size,
  readability-misleading-indentation,
  readability-redundant-declaration,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-duplicate-include,
  misc-unused-using-decls,
  misc-unused-parameters,
  misc-definitions-in-headers,
  performance-unnecessary-copy-initialization,
  performance-for-range-copy,
  google-build-using-namespace,
  cppcoreguidelines-pro-type-cstyle-cast

WarningsAsErrors: ''
HeaderFilterRegex: '^.*/(Common|Engine|Compiler|Tools|Plugins|Editor/AGS\.Native)/(?!libsrc/|libinclude/).*\.(h|hpp|inl)$'
FormatStyle: file

CheckOptions:
  # Size limits apply to new and rewritten code; legacy offenders are tracked in BASELINE.md
  readability-function-size.LineThreshold: 120
  readability-function-size.NestingThreshold: 4
  readability-function-size.ParameterThreshold: 7
  # int8_t is a number (Stream::ReadInt8, the save formats), not a character
  bugprone-signed-char-misuse.CharTypdefsToIgnore: 'int8_t'

  # --- naming (mirrors STYLE.md, section "Naming") ---
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase

  readability-identifier-naming.FunctionCase: CamelCase
  # Script API implementations (Character_AddInventory) and wrappers (Sc_Character_AddInventory)
  readability-identifier-naming.FunctionIgnoredRegexp: '^(Sc_)?[A-Z][A-Za-z0-9]*_[A-Za-z0-9_]+$'
  readability-identifier-naming.MethodCase: CamelCase

  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.LocalConstantCase: lower_case
  readability-identifier-naming.StaticVariableCase: lower_case

  readability-identifier-naming.PrivateMemberPrefix: '_'
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberPrefix: '_'
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.PublicMemberCase: CamelCase

  readability-identifier-naming.EnumConstantPrefix: 'k'
  readability-identifier-naming.EnumConstantCase: aNy_CasE
  readability-identifier-naming.ScopedEnumConstantPrefix: ''
  readability-identifier-naming.ScopedEnumConstantCase: CamelCase

  readability-identifier-naming.ConstexprVariablePrefix: 'k'
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: 'k'
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: 'k'
  readability-identifier-naming.ClassConstantCase: CamelCase

  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # Include guards are being replaced by #pragma once (PLAN.md, task 2.5)
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^__.*_H(PP)?$'

  # Not a length rule, and not in Checks: Script/tidy_diff.py turns this check on to hear of every
  # variable and parameter declared on a changed line, and reports the ones on the watchlist of
  # banned abbreviations (CRYPTIC_WATCHLIST in Script/refactor_metrics.py; STYLE.md "Naming").
  readability-identifier-length.MinimumVariableNameLength: 99
  readability-identifier-length.MinimumParameterNameLength: 99
  readability-identifier-length.MinimumLoopCounterNameLength: 99
  readability-identifier-length.MinimumExceptionNameLength: 99
  readability-identifier-length.IgnoredVariableNames: ''
  readability-identifier-length.IgnoredParameterNames: ''
  readability-identifier-length.IgnoredLoopCounterNames: ''
  readability-identifier-length.IgnoredExceptionVariableNames: ''
...
