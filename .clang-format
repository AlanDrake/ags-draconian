# AGS Draconian C/C++ formatting rules. See docs/refactor/STYLE.md.
# Pinned tool: clang-format 19.1.x (pip install clang-format==19.1.7).
# Third-party directories carry their own .clang-format with DisableFormat: true.
---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++17
ColumnLimit: 120
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4
IndentCaseLabels: false
NamespaceIndentation: None
FixNamespaceComments: true
CompactNamespaces: false

BreakBeforeBraces: Allman
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: false
AllowShortLambdasOnASingleLine: All
AlwaysBreakTemplateDeclarations: Yes
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: CurrentLine

PointerAlignment: Right
ReferenceAlignment: Pointer
DerivePointerAlignment: false
SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements
Cpp11BracedListStyle: true

AlignAfterOpenBracket: Align
AlignTrailingComments: true
AlignConsecutiveMacros: Consecutive
AlignEscapedNewlines: Left
BinPackArguments: true
BinPackParameters: true

MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: false
InsertNewlineAtEOF: true

# Comments are rewritten by hand, never reflowed (reflow mangles ASCII tables and diagrams).
ReflowComments: false
# Include order (docs/refactor/STYLE.md): the file's own header, C/C++ standard headers, other
# system and third-party headers, then AGS headers; one blank line between the groups.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # The <windows.h> wrapper has to come before any other Windows header (<shlwapi.h>, <Psapi.h>, ...)
  - Regex: '^"platform/windows/windows\.h"$'
    Priority: 1
  # C++ standard library (<vector>, <cstdio>) and C standard headers (<stdio.h>)
  - Regex: '^<([a-z_0-9]+|(assert|ctype|errno|float|inttypes|limits|locale|math|setjmp|signal|stdarg|stddef|stdint|stdio|stdlib|string|time|wchar)\.h)>$'
    Priority: 2
  # everything else in angle brackets: platform, SDL, Allegro, ...
  - Regex: '^<.*>$'
    Priority: 3
  # AGS headers
  - Regex: '^".*"$'
    Priority: 4
SortUsingDeclarations: false
...
