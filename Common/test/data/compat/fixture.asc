// Compatibility fixture (ags-draconian, docs/refactor/PLAN.md task 1.2). With no save in slot 1
// it sets known state, saves to slot 1 and quits: run once by the engine of the editor that built
// it. With a save, it restores it, checks the state and writes c1result.txt: run by the tests.
int c1_frame;
int c1_marker;
int c1_inv_before;
String c1_text;
int c1_arr[];

function c1_report(String result)
{
  File *f = File.Open("$SAVEGAMEDIR$/c1result.txt", eFileWrite);
  f.WriteRawLine(result);
  f.Close();
  QuitGame(0);
}

function c1_tick()
{
  c1_frame++;
  if (c1_frame == 1)
  {
    if (Game.GetSaveSlotDescription(1) != null)
    {
      RestoreGameSlot(1);
      return;
    }
    c1_marker = 4242;
    c1_inv_before = player.InventoryQuantity[2];
    player.AddInventory(inventory[2]);
    player.x = 123;
    player.y = 145;
    c1_text = String.Format("fixture %d", 7);
    c1_arr = new int[3];
    c1_arr[2] = 99;
    hotspot[1].Enabled = false;
    player.Transparency = 37; // reads back as 38 in AGS 4.0
    SaveGameSlot(1, "c1 fixture");
  }
  else if (c1_frame == 10)
  {
    QuitGame(0);
  }
}

function on_event(EventType event, int data)
{
  if (event != eEventRestoreGame)
    return;
  String err = "";
  if (c1_marker != 4242)
    err = err.Append(" marker");
  if (player.InventoryQuantity[2] != c1_inv_before + 1)
    err = err.Append(" inventory");
  if (player.Room != 1 || player.x != 123 || player.y != 145)
    err = err.Append(" position");
  if (c1_text == null || c1_text != "fixture 7")
    err = err.Append(" string");
  if (c1_arr == null || c1_arr[2] != 99)
    err = err.Append(" array");
  if (hotspot[1].Enabled)
    err = err.Append(" hotspot");
  if (player.Transparency != 38)
    err = err.Append(String.Format(" transparency=%d", player.Transparency));
  if (err.Length == 0)
    c1_report("PASS");
  else
    c1_report(String.Format("FAIL%s", err));
}

