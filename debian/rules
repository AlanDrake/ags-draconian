#!/usr/bin/make -f

# Keep this list of folders that are not included in the
# orig syncronized with the one in debian/source/local-options!
ORIG_CONTENT := $(shell git ls-tree --name-only HEAD | grep -Ev '^(Android|Editor|iOS|OSX|Windows|debian|\.git.*)')
VERSION := $(shell head -1 debian/changelog | sed 's/.*(\(.*\)).*/\1/')
GENCONTROL_SUBSTVARS = -Vbuildinfo:Date="$(shell date -R)" -Vbuildinfo:Git-Object="$(shell git show HEAD | head -n1)"

# The engine is built with CMake, out of the source tree. SDL2, SDL_sound, ogg, theora and vorbis are the
# installed ones (what the Makefile build took through pkg-config and sdl2-config); the rest comes from the
# sources in the repository. FETCHCONTENT_FULLY_DISCONNECTED makes a library that was missed an error
# instead of a download. RelWithDebInfo is -O2 -g -DNDEBUG, without LTO: the flags of the Makefile build,
# and the -g that ags-dbg is made from.
BUILD_DIR = build-debian
JOBS = $(or $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS))),$(shell nproc))
CMAKE_ARGS = \
	-DCMAKE_BUILD_TYPE=RelWithDebInfo \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DAGS_USE_LOCAL_SDL2=ON \
	-DAGS_USE_LOCAL_SDL2_SOUND=ON \
	-DAGS_USE_LOCAL_OGG=ON \
	-DAGS_USE_LOCAL_THEORA=ON \
	-DAGS_USE_LOCAL_VORBIS=ON \
	-DFETCHCONTENT_FULLY_DISCONNECTED=ON

# DEB_BUILD_OPTIONS=rpath=lib64: the binary looks for its libraries in $ORIGIN/lib64 (see debian/build.sh)
ifneq (,$(filter rpath=%,$(DEB_BUILD_OPTIONS)))
  RPATH = $(patsubst rpath=%,%,$(filter rpath=%,$(DEB_BUILD_OPTIONS)))
  CMAKE_ARGS += -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON '-DCMAKE_INSTALL_RPATH=$$ORIGIN/$(RPATH)'
endif

ifneq (,$(BUILD_STR))
  CMAKE_ARGS += '-DAGS_BUILD_STR=$(BUILD_STR)'
endif

%:
	dh $@ --parallel

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

override_dh_auto_clean:
	rm -rf $(BUILD_DIR)

override_dh_auto_configure:
	cmake -S . -B $(BUILD_DIR) $(CMAKE_ARGS)

override_dh_auto_build:
	cmake --build $(BUILD_DIR) --parallel $(JOBS)

override_dh_auto_test:

override_dh_auto_install:
	cmake --install $(BUILD_DIR) --prefix $(CURDIR)/debian/tmp/usr

override_dh_clean:
	dh_clean --exclude=Editor/*

get-orig-source:
	mkdir -p ../orig_temp/ags_$(VERSION)
	debian/git-archive-all.sh ../orig_temp/ags_$(VERSION)/orig_temp.tar
	cd ../orig_temp/ags_$(VERSION) && tar -xf orig_temp.tar $(ORIG_CONTENT)
	rm ../orig_temp/ags_$(VERSION)/orig_temp.tar
	cd ../orig_temp && tar -pczf ../ags_$(VERSION).orig.tar.gz ags_$(VERSION)
	rm -rf ../orig_temp

override_dh_gencontrol:
	dh_gencontrol -- $(GENCONTROL_SUBSTVARS)

.PHONY: override_dh_strip
override_dh_strip:
	dh_strip --dbg-package=ags-dbg
