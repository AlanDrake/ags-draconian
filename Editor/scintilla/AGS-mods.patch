diff --git a/src/PropSet.cxx b/src/PropSet.cxx
index c563d2b..f1bd421 100644
--- a/src/PropSet.cxx
+++ b/src/PropSet.cxx
@@ -18,8 +18,13 @@
 // The comparison and case changing functions here assume ASCII
 // or extended ASCII such as the normal Windows code page.
 
+// ** CJ CHANGE: Underscores are sorted by the .NET app
+// at the top of the list, whereas scintilla assumes they're sorted
+// by their ASCII value. So pretend they are dashes
 static inline char MakeUpperCase(char ch) {
-	if (ch < 'a' || ch > 'z')
+  if (ch == '_')
+    return '-';
+	else if (ch < 'a' || ch > 'z')
 		return ch;
 	else
 		return static_cast<char>(ch - 'a' + 'A');
